---
import DocPage from '../../../components/DocPage.astro';
import { hostNotes } from '../../../lib/docs';
import { hostBySlug } from '../../../lib/inventory';
import { url } from '../../../lib/paths';

export function getStaticPaths() {
  return hostNotes.map((doc) => {
    const [, slug, ...rest] = doc.route.split('/');
    return { params: { slug, note: rest.join('/') }, props: { doc, slug } };
  });
}
const { doc, slug } = Astro.props;
---
<DocPage
  doc={doc}
  section="hosts"
  crumbs={[
    { label: 'Hosts', href: url('hosts') },
    { label: hostBySlug.get(slug)!.name, href: url(`hosts/${slug}`) },
  ]}
/>
