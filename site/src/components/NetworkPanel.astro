---
import type { Network } from '../lib/inventory';
import HostChip from './HostChip.astro';

interface Props {
  network: Network;
}
const { network: n } = Astro.props;
---
<article class="panel" data-panel={`net:${n.id}`} hidden>
  <header class="panel-head">
    <h2 tabindex="-1">{n.name}</h2>
    <button class="panel-close" type="button" data-clear aria-label="Close and show the whole topology">
      <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m3 3 12 12M15 3 3 15" /></svg>
    </button>
    <p class="panel-sub"><span>Network</span></p>
  </header>
  {n.cidr ? (
    <ul class="addresses"><li><span class="num">{n.cidr}</span><span class="addr-label">Address range</span></li></ul>
  ) : (
    <p class="panel-role">No addressing: a bridge with no physical port.</p>
  )}
  <dl class="facts" style="margin-top:14px">
    {n.gateway && (<><dt>Gateway</dt><dd class="num">{n.gateway}</dd></>)}
    {n.dhcp_pool && (<><dt>DHCP pool</dt><dd class="num">{n.dhcp_pool}</dd></>)}
    {n.dns && (<><dt>DNS</dt><dd>{n.dns}</dd></>)}
    {n.domain && (<><dt>Domain</dt><dd class="num">{n.domain}</dd></>)}
  </dl>
  {n.notes && <p class="panel-role">{n.notes}</p>}
  <h3>Hosts on it</h3>
  <ul class="chips">{n.members.map((s) => <li><HostChip slug={s} select /></li>)}</ul>
</article>
