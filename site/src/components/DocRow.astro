---
import { TYPE_LABEL, type Doc } from '../lib/docs';
import { shortDate } from '../lib/format';
import { url } from '../lib/paths';
import HostChip from './HostChip.astro';

interface Props {
  doc: Doc;
}
const { doc } = Astro.props;
const [day, month] = shortDate(doc.date).split(' ');
---
<li
  class="doc-row"
  data-type={doc.type}
  data-hosts={doc.hosts.join(' ')}
  data-tags={doc.tags.join(' ')}
  data-status={doc.status}
  data-open={doc.open}
  data-text={`${doc.title} ${doc.summary} ${doc.tags.join(' ')} ${doc.hosts.join(' ')}`.toLowerCase()}
>
  <time class="doc-row-date num" datetime={doc.date}>{day} {month}</time>
  <div class="doc-row-body">
    <a class="doc-row-title" href={url(doc.route)}>{doc.title}</a>
    {doc.summary && <p class="doc-row-summary">{doc.summary}</p>}
    {doc.hosts.length > 0 && (
      <ul class="doc-row-meta chips">
        {doc.hosts.map((s) => <li><HostChip slug={s} quiet /></li>)}
      </ul>
    )}
  </div>
  <div class="doc-row-end">
    <span class="tag" data-type={doc.type}>{TYPE_LABEL[doc.type]}</span>
    {doc.open > 0 && <span class="tag is-open">{doc.open} open</span>}
    {doc.status === 'in-progress' && <span class="tag">In progress</span>}
    {doc.status === 'superseded' && <span class="tag">Superseded</span>}
  </div>
</li>
