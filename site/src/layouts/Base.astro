---
import '@fontsource-variable/league-spartan';
import '@fontsource-variable/red-hat-text';
import '@fontsource-variable/red-hat-mono';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { statusSnapshot } from '../lib/inventory';
import { shortDate } from '../lib/format';
import { url } from '../lib/paths';
import { GITHUB_REPO } from '../lib/repo';

interface Props {
  title?: string;
  description?: string;
  section?: 'map' | 'hosts' | 'writeups' | 'follow-ups';
}
const { title, description = 'A two-machine homelab: topology, hosts, addresses and ports, and the writeups behind every change.', section } = Astro.props;
const fullTitle = title ? `${title} | The Archivist` : 'The Archivist homelab';

const nav = [
  { id: 'map', label: 'Topology', short: 'Map', href: url() },
  { id: 'hosts', label: 'Hosts', short: 'Hosts', href: url('hosts') },
  { id: 'writeups', label: 'Writeups', short: 'Writeups', href: url('writeups') },
  { id: 'follow-ups', label: 'Follow-ups', short: 'Follow-ups', href: url('follow-ups') },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline>
      // Apply a saved theme before first paint. No saved choice: follow the system.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href={url()}>
          <Mark />
          <span>The Archivist</span>
        </a>
        <nav class="site-nav" aria-label="Sections">
          {nav.map((n) => (
            <a href={n.href} aria-current={section === n.id ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="header-tools">
          <button class="icon-button search-open" type="button" data-search-open>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 5 5" /></svg>
            <span>Search</span>
            <kbd>/</kbd>
          </button>
          <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
            <svg class="sun" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="3.5" /><path d="M10 1.5v2.5M10 16v2.5M1.5 10H4M16 10h2.5M4 4l1.8 1.8M14.2 14.2 16 16M4 16l1.8-1.8M14.2 5.8 16 4" /></svg>
            <svg class="moon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>
        Host status is a snapshot observed {shortDate(statusSnapshot.asOf)}{statusSnapshot.live ? '' : ', not a live feed'}.
      </span>
      <span>Built from the files tracked in <a href={GITHUB_REPO} rel="noopener">tharold4096/thearchivist</a>.</span>
    </footer>

    <nav class="tabbar" aria-label="Sections">
      <a href={url()} aria-current={section === 'map' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="6" /><rect x="14" y="3" width="7" height="6" /><rect x="3" y="15" width="18" height="6" /><path d="M6.5 9v6M17.5 9v6" /></svg>
        Map
      </a>
      <a href={url('hosts')} aria-current={section === 'hosts' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="6" /><rect x="3" y="14" width="18" height="6" /><path d="M7 7h.01M7 17h.01" /></svg>
        Hosts
      </a>
      <a href={url('writeups')} aria-current={section === 'writeups' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3h9l4 4v14H6z" /><path d="M9.5 11h6M9.5 15h6" /></svg>
        Writeups
      </a>
      <a href={url('follow-ups')} aria-current={section === 'follow-ups' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="16" height="16" /><path d="m8 12 3 3 5-6" /></svg>
        Follow-ups
      </a>
      <button type="button" data-search-open>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5.5 5.5" /></svg>
        Search
      </button>
    </nav>

    <dialog class="search-dialog" data-search aria-label="Search hosts and writeups">
      <form class="search-bar" method="dialog">
        <input type="search" placeholder="Host, address, port, service or any word" autocomplete="off" spellcheck="false" aria-label="Search" data-search-input />
        <button class="button is-plain" type="submit">Close</button>
      </form>
      <div class="search-results" data-search-results aria-live="polite">
        <p class="search-note">Type a host name, an address like <span class="num">192.168.10.204</span>, a port like <span class="num">8096</span>, or any word from a writeup.</p>
      </div>
    </dialog>

    <script define:vars={{ indexUrl: url('search-index.json') }} is:inline>
      window.__searchIndexUrl = indexUrl;
    </script>
    <script>
      // Theme toggle ------------------------------------------------------
      const root = document.documentElement;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });

      // Search -------------------------------------------------------------
      interface Entry {
        k: 'host' | 'doc' | 'journal';
        t: string; // title
        u: string; // url
        w: string; // where: type or kind label
        s: string; // summary line
        x: string; // key terms (addresses, ports, tags) — weighted
        b: string; // body text
      }
      const dialog = document.querySelector<HTMLDialogElement>('[data-search]')!;
      const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
      const results = dialog.querySelector<HTMLElement>('[data-search-results]')!;
      const intro = results.innerHTML;
      let index: Entry[] | null = null;
      let loading: Promise<void> | null = null;

      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

      function load() {
        loading ??= fetch((window as any).__searchIndexUrl)
          .then((r) => {
            if (!r.ok) throw new Error(String(r.status));
            return r.json();
          })
          .then((data: Entry[]) => {
            index = data;
          })
          .catch(() => {
            loading = null;
            results.innerHTML = '<p class="search-note">The search index did not load. Check the connection and type again.</p>';
          });
        return loading;
      }

      function mark(text: string, terms: string[]) {
        let out = esc(text);
        for (const t of terms) {
          if (t.length < 2) continue;
          out = out.replace(new RegExp(`(${esc(t).replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi'), '<mark>$1</mark>');
        }
        return out;
      }

      function snippet(e: Entry, terms: string[]) {
        const hay = e.b.toLowerCase();
        const at = Math.min(...terms.map((t) => hay.indexOf(t)).filter((i) => i >= 0), Infinity);
        if (!isFinite(at) || e.s.toLowerCase().includes(terms[0])) return e.s;
        const start = Math.max(0, at - 50);
        return (start ? '… ' : '') + e.b.slice(start, start + 170);
      }

      function run() {
        const q = input.value.trim().toLowerCase();
        if (!q) {
          results.innerHTML = intro;
          return;
        }
        if (!index) return;
        const terms = q.split(/\s+/);
        const scored = index
          .map((e) => {
            const title = e.t.toLowerCase();
            const keys = e.x.toLowerCase();
            const sum = e.s.toLowerCase();
            const body = e.b.toLowerCase();
            let score = 0;
            for (const t of terms) {
              const inTitle = title.includes(t);
              const inKeys = keys.includes(t);
              const inSum = sum.includes(t);
              const inBody = body.includes(t);
              if (!inTitle && !inKeys && !inSum && !inBody) return null;
              score += (inTitle ? 10 : 0) + (inKeys ? 6 : 0) + (inSum ? 3 : 0) + (inBody ? 1 : 0);
              if (title.startsWith(t)) score += 4;
            }
            return { e, score };
          })
          .filter((r): r is { e: Entry; score: number } => r !== null)
          .sort((a, b) => b.score - a.score);

        if (!scored.length) {
          results.innerHTML = `<p class="search-note">Nothing matches “${esc(input.value.trim())}”. Try a shorter word, or part of an address.</p>`;
          return;
        }
        const groups: [Entry['k'], string][] = [
          ['host', 'Hosts'],
          ['doc', 'Writeups'],
          ['journal', 'Responder journal'],
        ];
        results.innerHTML = groups
          .map(([k, label]) => {
            const hits = scored.filter((r) => r.e.k === k).slice(0, k === 'host' ? 8 : 12);
            if (!hits.length) return '';
            return `<h3>${label}</h3><ul>${hits
              .map(
                ({ e }) =>
                  `<li><a class="search-hit" href="${esc(e.u)}"><b>${mark(e.t, terms)}</b><span class="where">${esc(e.w)}</span><span class="snip">${mark(snippet(e, terms), terms)}</span></a></li>`,
              )
              .join('')}</ul>`;
          })
          .join('');
      }

      function open() {
        if (!dialog.open) dialog.showModal();
        input.select();
        load().then(run);
      }

      document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
      input.addEventListener('input', () => (index ? run() : load().then(run)));
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
      document.addEventListener('keydown', (e) => {
        const typing = e.target instanceof HTMLElement && e.target.matches('input, textarea, select, [contenteditable]');
        if ((e.key === '/' && !typing) || (e.key === 'k' && (e.metaKey || e.ctrlKey))) {
          e.preventDefault();
          open();
        }
        if (e.key === 'ArrowDown' && dialog.open && e.target === input) {
          e.preventDefault();
          results.querySelector<HTMLElement>('.search-hit')?.focus();
        }
      });
      results.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        const hits = [...results.querySelectorAll<HTMLElement>('.search-hit')];
        const i = hits.indexOf(document.activeElement as HTMLElement);
        e.preventDefault();
        if (e.key === 'ArrowUp' && i <= 0) input.focus();
        else hits[i + (e.key === 'ArrowDown' ? 1 : -1)]?.focus();
      });
    </script>
  </body>
</html>
