# --- Config exports & backups (the actual incident cause) ---
# OPNsense/pfSense config exports contain auth keys, password hashes, addressing
*.xml
config-backups/
*config-export*
*backup*.xml

# --- Anything that looks like a secret, by name ---
*secret*
*token*
*apikey*
*api_key*
*authkey*
*auth_key*
*password*
*credential*
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
id_ecdsa
*.ppk

# --- Environment / dotenv files ---
.env
.env.*
*.env

# --- iDRAC / Dell firmware payloads (large binaries, don't belong in git anyway) ---
*.d6
*.BIN
*.exe

# --- SSH known_hosts (leaks IPs/hostnames you've connected to) ---
known_hosts
known_hosts2

# --- Tailscale / VPN state ---
*.tsnet-cache/
tailscale.state

# --- OS/editor junk ---
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# --- Logs (can leak internal IPs/topology) ---
*.log
logs/

# --- Narrow exceptions to the blanket *.xml rule above -------------------
# That rule exists to stop OPNsense/pfSense CONFIG EXPORTS, which carry auth
# keys, password hashes and addressing. Wazuh rule and agent-config fragments
# are also .xml but contain no credentials — they are rule logic only.
# Each exception is listed individually and ON PURPOSE. Do not broaden this
# to `!configs/**/*.xml`: that would let a future config export slip through
# just by being dropped in the right directory.
!configs/wazuh-manager/local_rules.xml
!configs/thearchivist/ossec-additions.xml

# --- Python bytecode ---
__pycache__/
*.pyc

# --- arr media stack: kept locally only, never published ---
# Everything about the arr stack (Sonarr/Radarr/Prowlarr/Seerr/qBittorrent/
# FlareSolverr, indexers, VPN for downloads) lives on the local machine only.
# Name new arr files with one of these tokens, or put them under an arr-stack/ dir.
*arr-stack*
arr-stack/
*sonarr*
*radarr*
*prowlarr*
*lidarr*
*readarr*
*bazarr*
*seerr*
*qbittorrent*
*flaresolverr*
