#!/usr/bin/python3 -I
"""cmk-read HOST [SERVICE]: read-only Checkmk lookup for Claude. Installed /usr/local/bin/cmk-read (root 755).

Uses the Checkmk automation user `responder-ro` (guest role: can see, cannot change).
Secret: /etc/responder/cmk-ro.secret (root:rclaude 640). Output is untrusted text.

  cmk-read HOST            host state + every non-OK service on it
  cmk-read HOST SERVICE    one service in full, including long output
"""
import json
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

API = "http://192.168.10.215/monitoring/check_mk/api/1.0"
USER = "responder-ro"
SECRET_FILE = "/etc/responder/cmk-ro.secret"
STATES = {0: "OK", 1: "WARN", 2: "CRIT", 3: "UNKNOWN"}
HOST_STATES = {0: "UP", 1: "DOWN", 2: "UNREACHABLE"}
LIMIT = 16384


def get(path, params):
    with open(SECRET_FILE) as f:
        secret = f.read().strip()
    url = f"{API}{path}?{urllib.parse.urlencode(params, doseq=True)}"
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {USER} {secret}", "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.load(resp)


def main(argv):
    if len(argv) not in (2, 3) or not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", argv[1]):
        print("usage: cmk-read <checkmk-host> [service description]", file=sys.stderr)
        return 64
    host = argv[1]
    try:
        hosts = get("/domain-types/host/collections/all", {
            "query": json.dumps({"op": "=", "left": "name", "right": host}),
            "columns": ["name", "state", "plugin_output"]})["value"]
        if not hosts:
            print(f"cmk-read: no host '{host}' in Checkmk", file=sys.stderr)
            return 66
        h = hosts[0]["extensions"]
        out = [f"host {host}: {HOST_STATES.get(h['state'], h['state'])} - {h['plugin_output']}"]
        params = {"host_name": host, "columns": [
            "description", "state", "plugin_output", "long_plugin_output",
            "last_state_change", "last_check", "acknowledged"]}
        if len(argv) == 3:
            params["query"] = json.dumps({"op": "=", "left": "description", "right": argv[2]})
        services = get("/domain-types/service/collections/all", params)["value"]
    except (urllib.error.URLError, OSError, KeyError, ValueError) as exc:
        print(f"cmk-read: Checkmk API error: {exc}", file=sys.stderr)
        return 75
    shown = 0
    for s in services:
        e = s["extensions"]
        if len(argv) == 2 and e["state"] == 0:
            continue
        shown += 1
        out.append(f"\n[{STATES.get(e['state'], e['state'])}] {e['description']}"
                   f" (last change epoch {e['last_state_change']}, last check {e['last_check']},"
                   f" ack {e['acknowledged']})\n  {e['plugin_output']}")
        if e.get("long_plugin_output"):
            out.append("  " + e["long_plugin_output"].replace("\\n", "\n  "))
    if not shown:
        out.append("\n(no matching service)" if len(argv) == 3 else "\n(all services OK)")
    print("\n".join(out)[:LIMIT])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
