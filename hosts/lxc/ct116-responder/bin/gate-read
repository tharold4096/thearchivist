#!/usr/bin/python3 -I
"""gate-read HOST VERB: Claude's only path to a target. Installed /usr/local/bin/gate-read (root 755).

Runs as `rclaude` with rclaude's own key. The target's authorized_keys pins that key to
`command="/usr/local/bin/rgate read"`, so a write verb is refused on the target even if
this wrapper were bypassed. This script is a convenience filter, not the boundary.
"""
import re
import subprocess
import sys

sys.path.insert(0, "/opt/responder")
from registry import Registry  # noqa: E402

KEY = "/var/lib/rclaude/.ssh/read_ed25519"
KNOWN_HOSTS = "/etc/responder/known_hosts"


def main(argv):
    if len(argv) != 3:
        print("usage: gate-read <host> <status|logs|health>", file=sys.stderr)
        return 64
    host, verb = argv[1], argv[2]
    if not re.fullmatch(r"[a-z0-9-]{1,32}", host) or not re.fullmatch(r"[a-z]{1,16}", verb):
        print("gate-read: bad argument", file=sys.stderr)
        return 64
    reg = Registry.load()
    if not reg.is_read(host, verb):
        hosts = ", ".join(sorted(reg.hosts)) or "none"
        print(f"gate-read: '{verb}' on '{host}' is not a registered read verb (hosts: {hosts})",
              file=sys.stderr)
        return 64
    ip = reg.host(host)["ip"]
    cmd = ["ssh", "-i", KEY, "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes",
           "-o", "StrictHostKeyChecking=yes", "-o", f"UserKnownHostsFile={KNOWN_HOSTS}",
           "-o", "ConnectTimeout=10", "-T", f"rgate@{ip}", verb]
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=45)
    except subprocess.TimeoutExpired:
        print("gate-read: timed out", file=sys.stderr)
        return 75
    sys.stdout.write(r.stdout.decode(errors="replace")[:16384])
    sys.stderr.write(r.stderr.decode(errors="replace")[:2048])
    return r.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv))
